---
layout: null
permalink: /search.json
---
{%- assign docs = site.pages | where_exp: "p", "p.name contains '.md'" -%}
[
{%- for p in docs -%}
{%- assign t = p.title | default: site.title | remove_first: "Question de Dieu : " -%}
{"titre": {{ t | jsonify }}, "url": {{ p.url | relative_url | jsonify }}, "texte": {{ p.content | markdownify | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
